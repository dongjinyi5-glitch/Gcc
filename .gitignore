# Binary / large assets
extracted/primary/**/*.png
extracted/primary/**/*.tga
extracted/primary/**/*.dds
extracted/primary/**/*.wav
extracted/primary/**/*.ogg
extracted/primary/**/*.avi
*.pak
*.bundle

# 原始 .assets 备份（约 2.7GB，仅本地回滚用，不入库）
# 回滚方法见 validation/STEP4_INGAME_VERIFICATION.md 第 7 节
backup/
*.assets
!validation/roundtrip_*.assets

# 调试草稿：art/ 顶层下划线前缀的图（对齐检查、放大切片等），不是交付物。
# 注意只匹配 art/ 顶层，art/<char>_parts/_native_canvas.png 这类管线产物照常入库。
art/_*.png

# 一次性诊断渲染：把某个部件拷一份改空再看合成结果，用完即弃，不是交付物。
art/*_parts/diag/
art/*_parts/_character_compare_diag.png
validation/composite_*_diag*.png

# Tools binaries
tools/bin/*.exe
tools/bin/*.dll

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# OS
Thumbs.db
.DS_Store
desktop.ini

# IDE
.vscode/
.idea/

# Logs (keep structure, ignore content)
tools/logs/*.log
